# Copy to .env and set every required value before starting Compose.
STAGING_DOMAIN=staging.example.org
POSTGRES_DB=personnel_camps
POSTGRES_USER=personnel_app
POSTGRES_PASSWORD=
JWT_SECRET=
# Public age recipient (age1...). Keep the matching private key off-host.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
# Temporary one-time value used only by the bootstrap profile; remove after seeding.
BOOTSTRAP_ADMIN_PASSWORD=
